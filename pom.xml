<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.5</version>
    <relativePath/>
  </parent>

  <groupId>com.maragramonte</groupId>
  <artifactId>photo-palette</artifactId>
  <version>1.0.0</version>
  <name>photo-palette</name>
  <description>Cada foto esconde una paleta. Esta API la encuentra.</description>

  <properties>
    <java.version>21</java.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <jacoco.version>0.8.13</jacoco.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>paletas</id>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.maragramonte.photopalette.cli.GeneradorPaletasJson</mainClass>
              <arguments>
                <argument>web/fotos</argument>
                <argument>web/paletas.json</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Cobertura: el agente se engancha a surefire y el informe sale en
           target/site/jacoco con `mvn verify`. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>agente</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>informe</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- Suelo por debajo de lo medido (96 % de líneas y 91 % de ramas en la API),
               para que avise si baja de verdad y no por un if de más. El generador de
               paletas.json es una herramienta de desarrollo que se ejecuta a mano: sale en
               el informe, pero no cuenta para el suelo. -->
          <execution>
            <id>suelo</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <excludes>
                <exclude>com/maragramonte/photopalette/cli/**</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.85</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
